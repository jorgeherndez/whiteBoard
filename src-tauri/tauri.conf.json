{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhiteBoard",
  "version": "0.2.2",
  "identifier": "com.jorgeherndez.whiteboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WhiteBoard",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFQ0YxNDBEMjNCNDE4NjIKUldSaUdMUWpEUlRQemhDZXRJcDZUaTV5eFduazJqNWFQZzdSL0JhS0FtNWFBTVNUTC9kcmhYeVEK",
      "endpoints": [
        "https://github.com/jorgeherndez/whiteBoard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}